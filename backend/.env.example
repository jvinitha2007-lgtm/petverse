APP_ENV=development
DATABASE_URL=sqlite:///./petverse.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-use
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@petverse.local
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
